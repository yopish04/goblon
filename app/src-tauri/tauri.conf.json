{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioZea",
  "version": "0.2.0",
  "identifier": "com.studiozea.dtf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudioZea - DTF Halftone",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#121a15"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQjE3RjQwNjUxQ0ExRDgKUldUWW9SeGxRSCt4c2doRWcvcUVGRmtKMXk1czJhT1NHSkxHTDNndDR6emZ2Y2NVU2UwSmliRysK",
      "endpoints": ["https://github.com/yopish04/studiozea-update/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../../engine/models/LICENSE-Real-ESRGAN": "LICENSE-Real-ESRGAN", "../../engine/models/LICENSE-PaddleOCR": "LICENSE-PaddleOCR" },
    "shortDescription": "DTF halftone prepress",
    "longDescription": "StudioZea: gambar -> hapus background -> ukuran/DPI -> halftone (LPI, sudut, bentuk) -> PNG siap cetak DTF.",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
